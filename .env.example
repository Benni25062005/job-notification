# Nur serverseitig setzen. Keine echten Schlüssel ins Repository eintragen.
CRON_SECRET=
# Eigenständiger Lesezugriff für die Oberfläche: zufälliger Schlüssel, mindestens 32 Zeichen.
DASHBOARD_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=
# Erst nach Einrichtung und Vorschau aktivieren:
NOTIFICATIONS_ENABLED=false
# Getrennten Namespace für Test/Produktion verwenden.
REDIS_PREFIX=job-notification:production
